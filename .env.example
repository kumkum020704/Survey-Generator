# Copy this file to ".env" and fill in your key (or export these in your shell).
# The .env file is gitignored — never commit a real key.
#
#   cp .env.example .env      # then edit .env

# Google Gemini — free tier covers a 200-row run.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Set to "true" to turn on LLM open-text rewriting by default
# (equivalent to passing --llm on the command line). Leave false/blank to use
# the zero-cost template engine.
ENABLE_LLM_TEXT=false

# Optional: to use Anthropic Claude instead, run with --llm-provider claude
# and set this key. https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key_here
